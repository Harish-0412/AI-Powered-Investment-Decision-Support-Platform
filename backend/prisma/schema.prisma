// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum TransactionType {
  BUY
  SELL
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String
  riskLevel     RiskLevel      @default(MEDIUM)
  portfolios    Portfolio[]
  refreshTokens RefreshToken[]
  profile       UserProfile?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                String   @unique
  fullName            String?
  role                String?
  tagline             String?
  bio                 String?  @db.Text
  yearsLearning       Int?
  currentlyBuilding   String?  @db.Text
  technologies        Json?
  skills              Json?
  projects            Json?
  experience          Json?
  githubUsername      String?
  contactEmail        String?
  linkedin            String?
  twitter             String?
  calendly            String?
  discord             String?
  resumeUrl           String?
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([slug])
}

model Portfolio {
  id          String    @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings    Holding[]
  transactions Transaction[]
  metrics     PortfolioMetrics?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Holding {
  id              String    @id @default(uuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol          String
  quantity        Decimal   @db.Decimal(18, 6)
  averageBuyPrice Decimal   @db.Decimal(18, 6)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([portfolioId, symbol])
  @@index([symbol])
}

model Transaction {
  id          String          @id @default(uuid())
  portfolioId String
  portfolio   Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String
  type        TransactionType
  quantity    Decimal        @db.Decimal(18, 6)
  price       Decimal        @db.Decimal(18, 6)
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([portfolioId])
  @@index([symbol])
  @@index([date])
}

model StockAnalytics {
  id              String   @id @default(uuid())
  symbol          String   @unique
  technicalData   Json     // Indicators, regimes, etc.
  sentimentData   Json?
  fundamentalData Json?
  lastUpdated     DateTime @default(now())

  @@index([symbol])
}

model PortfolioMetrics {
  id              String    @id @default(uuid())
  portfolioId     String    @unique
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  riskMetrics     Json      // VaR, CVaR, Sharpe, etc.
  performanceData Json      // TWR, Rolling returns, etc.
  optimizationData Json?    // Suggested rebalancing
  lastUpdated     DateTime  @default(now())

  @@index([portfolioId])
}

model PredictionScore {
  id              String   @id @default(uuid())
  symbol          String
  timeframe       String   // e.g., "7d", "30d"
  score           Float    // -1 to 1 (Bearish to Bullish)
  confidence      Float
  features        Json     // Factors contributing to score
  createdAt       DateTime @default(now())

  @@unique([symbol, timeframe])
  @@index([symbol])
}

model SectorRisk {
  id              String   @id @default(uuid())
  sector          String   @unique
  volatility      Float
  correlation     Float    // Correlation with benchmark
  riskLevel       String
  lastUpdated     DateTime @default(now())
}

model SentimentScore {
  id              String   @id @default(uuid())
  symbol          String
  source          String   // e.g., "news", "twitter"
  score           Float    // -1 to 1
  magnitude       Float
  date            DateTime @default(now())

  @@index([symbol, date])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
